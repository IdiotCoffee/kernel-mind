Screen {
    background: #081120;
    color: white;
}

#hero-layout {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 0 8;
}

#ascii-panel {
    width: 1fr;
    content-align: center middle;
}

#ascii-art {
    color: #ff8c00;
    text-style: bold;
}

#hero-content {
    width: 50%;
    content-align: center middle;
    padding-left: 6;
}

#hero-title {
    color: #ff8c00;
    text-style: bold;
    margin-bottom: 1;
}

#hero-subtitle {
    color: white;
    text-style: bold;
    margin-bottom: 2;
}

#hero-description {
    color: #94a3b8;
    width: 70;
    margin-bottom: 3;
}

Button {
    background: #ff8c00;
    color: black;
    text-style: bold;
    border: none;
    width: 20;
}

Button:hover {
    background: #ff9f1c;
}
RetrievalPanel,
GraphPanel,
AnswerPanel,
LogsPanel {
    border: round #334155;
    background: #111827;
    padding: 1;
    margin-bottom: 1;
}

RichLog {
    background: #020617;
    color: white;
    border: round #334155;
}

Input {
    dock: bottom;
    background: #111827;
    color: white;
    border: round orange;
    margin: 1;
}

Input:focus {
    border: round orange;
}

Input Cursor {
    color: orange;
    background: orange;
}
